# Copy this file to .env and fill in your own key. Never commit .env (it's
# gitignored). Claude never sees or writes this value — set it yourself.
# Create one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Any OpenAI-compatible gateway works. For OpenRouter, set the base URL below;
# an "sk-or-" key is also auto-detected, so a key pasted into the browser upload
# panel routes correctly with no server config at all.
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_BASE_URL=

# Optional. Defaults to gpt-4o-mini. On OpenRouter a bare name is namespaced
# automatically (gpt-4o-mini -> openai/gpt-4o-mini); an explicitly namespaced
# value is passed through untouched.
OPENAI_MODEL=

# Local Postgres connection for the ingestion pipeline.
DATABASE_URL=postgresql://shaanraza@localhost:5432/correspondence_register

# Local, content-addressed file storage for uploaded originals + derived rasters.
STORAGE_ROOT=./storage

# Shared-password gate for when this is deployed somewhere reachable by more
# than just you. Leave blank for local dev (the gate is a no-op when unset).
APP_PASSWORD=

# CORS: the one frontend origin allowed to call this API. Defaults to local Vite.
ALLOWED_ORIGIN=http://localhost:5173
