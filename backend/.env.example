# Copy this file to .env and fill in your own key. Never commit .env (it's
# gitignored). Claude never sees or writes this value — set it yourself.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Local Postgres connection for the ingestion pipeline.
DATABASE_URL=postgresql://shaanraza@localhost:5432/correspondence_register

# Local, content-addressed file storage for uploaded originals + derived rasters.
STORAGE_ROOT=./storage

# Shared-password gate for when this is deployed somewhere reachable by more
# than just you. Leave blank for local dev (the gate is a no-op when unset).
APP_PASSWORD=

# CORS: the one frontend origin allowed to call this API. Defaults to local Vite.
ALLOWED_ORIGIN=http://localhost:5173
